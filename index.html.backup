x", "letterSpacing": "0.04em", "fontWeight": "400" } ], "title-sm": [ "18px", { "lineHeight": "24px", "letterSpacing": "-0.01em", "fontWeight": "500" } ], "headline-lg": [ "36px", { "lineHeight": "44px", "letterSpacing": "-0.03em", "fontWeight": "600" } ], "headline-md": [ "24px", { "lineHeight": "30px", "letterSpacing": "-0.02em", "fontWeight": "600" } ] } } } };</script></head><body class="bg-surface font-body-md text-on-surface antialiased selection:bg-secondary selection:text-on-secondary"><header class="fixed top-0 left-0 right-0 z-50 bg-surface/80 backdrop-blur-xl shadow-[0_1px_8px_rgba(0,0,0,0.04)]"><div class="h-16 max-w-7xl mx-auto px-gutter flex items-center justify-between gap-space-md"><div class="flex items-center gap-space-md"><a class="flex items-center gap-space-sm group" data-path="about" href="#"><img alt="RB Brand Logo" class="h-8 w-auto object-contain filter drop-shadow-[0_0_8px_rgba(76,215,246,0.6)]" src="https://lh3.googleusercontent.com/aida/AEtjO1VbSIWT-4hksJJEt7xgV_C8ELoDVtYqwrRT04MzlKNWYZXKayz-SebPC_GVFbJj05v7Xzgwth1UJq2EtPYk6ejJLxTEHmRT4srMvMu79bFpAskcTiTkGKBOPX56Oj6tBkFxVTc5lFB1L9ADWdZB0_DNRnF0WqlVl-3VA_lisNV8L1vkHhMLorAy_RFrY8Ffwyademh2nKx4MdiIA3UmpC6EHZF4OvOotJma9fgOcsNfdBj7Sn77SHVrSx4"><div class="flex flex-col"><span class="font-title-sm text-title-sm font-bold tracking-tight text-on-surface group-hover:text-secondary transition-colors">Rithika Babu</span><span class="font-caption text-caption text-secondary uppercase tracking-widest">Software Developer</span></div></a></div><nav class="hidden lg:flex items-center gap-space-xs p-space-xs rounded bg-surface-container-lowest/60" data-active-classes="bg-surface-container-high text-secondary"><a aria-current="page" class="px-space-md py-space-xs rounded font-label-code text-label-code transition-all bg-surface-container-high text-secondary" href="#"><span>About</span></a><a class="px-space-md py-space-xs rounded font-label-code text-label-code text-on-surface-variant hover:text-on-surface hover:bg-surface-container transition-all" href="#featured-projects"><span>Projects</span></a><a class="px-space-md py-space-xs rounded font-label-code text-label-code text-on-surface-variant hover:text-on-surface hover:bg-surface-container transition-all" href="#skills"><span>Skills</span></a><a class="px-space-md py-space-xs rounded font-label-code text-label-code text-on-surface-variant hover:text-on-surface hover:bg-surface-container transition-all" href="#timeline"><span>Timeline</span></a><a class="px-space-md py-space-xs rounded font-label-code text-label-code text-on-surface-variant hover:text-on-surface hover:bg-surface-container transition-all" href="#contact"><span>Contact</span></a></nav><div class="flex items-center gap-space-md"><div class="hidden sm:flex items-center gap-space-sm px-space-md py-space-xs rounded bg-surface-container-low"><span class="relative flex h-2 w-2"><span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-secondary opacity-75"></span><span class="relative inline-flex rounded-full h-2 w-2 bg-secondary"></span></span><span class="font-label-code text-label-code text-on-surface tracking-wider uppercase">Available for Opportunities</span></div><div class="flex items-center pl-space-xs"><img alt="Profile" class="w-8 h-8 rounded-full object-cover" src="https://lh3.googleusercontent.com/aida-public/AB6AXuB5H64bn7ctU8-eaXAe0jnazWP3HjFMefOG84uQp-ygKxCZAH6olOjtjVtOwSi8XJW1RUovo4kjTO6o2SVuVvwKJpvipcnyEN5O0ruXhqbvnZ5Khj6zsrt5Ge84TurnImr0c1EU7-d0KNCry6lDT08lDUOHnWBw21wRpBKB9FzCrPjGJH_vhUlfLAfTObCTYRub0mBKdy3lSibc0yKfPjxOUeTIxRo1CLaFfiLWGMaZt3eKm1YKUNd6cw"></div></div></div></header><main class="w-full pt-16 bg-surface min-h-screen"><div class="flex flex-col w-full"><section class="relative w-full overflow-hidden bg-surface py-space-xl px-gutter"><div class="absolute top-1/4 left-1/2 -translate-x-1/2 w-[700px] h-[350px] bg-secondary/10 rounded-full blur-[140px] pointer-events-none"></div><div class="absolute -top-24 right-10 w-96 h-96 bg-primary-container/15 rounded-full blur-[120px] pointer-events-none"></div><div class="max-w-7xl mx-auto flex flex-col gap-space-xl relative z-10"><div class="flex items-center gap-space-sm"></div><div class="grid grid-cols-1 lg:grid-cols-12 gap-space-xl items-center"><div class="lg:col-span-7 flex flex-col gap-space-lg"><div class="flex flex-col gap-space-xs"><div class="font-headline-md text-headline-md font-bold text-on-surface tracking-tight">RITHIKA BABU</div><h1 class="font-display-xl text-display-xl text-on-surface font-bold tracking-tight">Building Production Systems with <span class="text-transparent bg-clip-text bg-gradient-to-r from-secondary via-primary to-secondary-fixed-dim drop-shadow-[0_0_24px_rgba(76,215,246,0.35)]">AI + Full-Stack</span></h1></div><div class="p-space-md rounded bg-surface-container-low backdrop-blur-md shadow-md flex flex-col gap-space-xs"><div class="font-caption text-caption text-secondary uppercase tracking-widest flex items-center gap-space-xs"><span class="material-symbols-outlined text-sm">verified_user</span> Verified Credentials &amp; Track Record</div><p class="font-body-lg text-body-lg text-on-surface-variant font-medium leading-relaxed">2 years CreamCollar • React, NestJS, TypeScript • AI Minor @ IIT Ropar • MCA AI &amp; Data Science @ SRM</p></div><div class="flex flex-wrap items-center gap-space-md pt-space-xs"><a class="group inline-flex items-center gap-space-sm px-space-lg py-space-md rounded bg-secondary text-on-secondary font-body-md font-bold tracking-wide shadow-xl hover:bg-on-surface hover:text-surface-container-lowest transition-all" href="#featured-projects"><span class="material-symbols-outlined text-base transition-transform group-hover:translate-x-1">terminal</span><span>&gt; VIEW_PROJECTS</span></a><a class="inline-flex items-center gap-space-sm px-space-lg py-space-md rounded bg-surface-container-high/80 backdrop-blur-md text-on-surface font-body-md font-medium tracking-wide shadow-md hover:bg-surface-bright hover:text-secondary transition-all" href="#contact"><span class="material-symbols-outlined text-base">mail</span><span>GET IN TOUCH</span></a></div></div><div class="lg:col-span-5 flex flex-col"><div class="rounded-lg bg-surface-container-low/90 backdrop-blur-xl shadow-2xl p-space-md flex flex-col gap-space-md"><div class="flex items-center justify-between pb-space-sm bg-surface-container-lowest/60 -mx-space-md -mt-space-md px-space-md pt-space-sm rounded-t-lg"><div class="flex items-center gap-space-xs"><span class="w-2.5 h-2.5 rounded-full bg-error"></span><span class="w-2.5 h-2.5 rounded-full bg-secondary-container"></span><span class="w-2.5 h-2.5 rounded-full bg-secondary"></span><span class="font-label-code text-label-code text-on-surface-variant ml-space-xs">AGENT_KERNEL_DAEMON</span></div><span class="font-caption text-caption text-secondary uppercase bg-surface-container-highest px-space-xs py-0.5 rounded">LIVE TELEMETRY</span></div><div class="flex flex-col gap-space-xs font-label-code text-label-code text-on-surface-variant"><div class="text-outline">$ agent-orchestrator --target="e2e-workflow" --mode="hybrid"</div><div class="text-secondary">[INIT] Model Router: Claude 3.5 Sonnet &lt;-&gt; Groq LPU Core</div><div class="text-on-surface">[STEP 1] Context Window: 48,210 tokens loaded (4.2ms)</div><div class="text-primary">[STEP 2] Multi-Agent Delegation: 3 sub-agents dispatched</div></div><div class="p-space-sm rounded bg-surface-container-lowest/80 flex items-center justify-center"><svg class="w-full h-auto max-h-28 text-secondary" viewBox="0 0 420 120"><rect fill="currentColor" fill-opacity="0.1" height="50" rx="4" stroke="currentColor" stroke-width="1.5" width="80" x="10" y="35"></rect><text fill="#dae2fd" font-family="Space Mono" font-size="9" font-weight="bold" text-anchor="middle" x="50" y="58">USER_REQ</text><text fill="#4cd7f6" font-family="Space Mono" font-size="8" text-anchor="middle" x="50" y="72">Payload</text><path d="M 90 60 L 130 60" stroke="#4cd7f6" stroke-dasharray="3 3" stroke-width="1.5"></path><circle cx="110" cy="60" fill="#4cd7f6" r="3"></circle><rect fill="#171f33" height="80" rx="6" stroke="#d0bcff" stroke-width="1.5" width="120" x="130" y="20"></rect><text fill="#d0bcff" font-family="Space Grotesk" font-size="11" font-weight="bold" text-anchor="middle" x="190" y="48">AI ROUTER</text><text fill="#cbc3d7" font-family="Space Mono" font-size="8" text-anchor="middle" x="190" y="66">Groq &amp; Claude 3.5</text><text fill="#4cd7f6" font-family="Space Mono" font-size="8" text-anchor="middle" x="190" y="82">Sub-sec Latency</text><path d="M 250 45 L 290 30" stroke="#d0bcff" stroke-width="1.5"></path><path d="M 250 75 L 290 90" stroke="#4cd7f6" stroke-width="1.5"></path><rect fill="currentColor" fill-opacity="0.08" height="40" rx="4" stroke="#d0bcff" stroke-width="1.2" width="115" x="290" y="10"></rect><text fill="#d0bcff" font-family="Space Mono" font-size="8" font-weight="bold" text-anchor="middle" x="347" y="28">Playwright Engine</text><text fill="#cbc3d7" font-family="Space Mono" font-size="7" text-anchor="middle" x="347" y="42">DOM Interactor</text><rect fill="currentColor" fill-opacity="0.08" height="40" rx="4" stroke="#4cd7f6" stroke-width="1.2" width="115" x="290" y="70"></rect><text fill="#4cd7f6" font-family="Space Mono" font-size="8" font-weight="bold" text-anchor="middle" x="347" y="88">Prisma / Postgres</text><text fill="#cbc3d7" font-family="Space Mono" font-size="7" text-anchor="middle" x="347" y="102">State Memory</text></svg></div><div class="grid grid-cols-3 gap-space-xs text-center pt-space-xs"><div class="p-space-xs rounded bg-surface-container-lowest"><div class="font-caption text-caption text-outline">EXEC_TIME</div><div class="font-title-sm text-title-sm text-secondary font-bold">142ms</div></div><div class="p-space-xs rounded bg-surface-container-lowest"><div class="font-caption text-caption text-outline">SUCCESS</div><div class="font-title-sm text-title-sm text-primary font-bold">99.98%</div></div><div class="p-space-xs rounded bg-surface-container-lowest"><div class="font-caption text-caption text-outline">CONCURRENCY</div><div class="font-title-sm text-title-sm text-on-surface font-bold">1.2k req/s</div></div></div></div></div></div></section><section class="w-full bg-surface-dim py-space-xl px-gutter relative" id="featured-projects"><div class="max-w-7xl mx-auto flex flex-col gap-space-xl"><div class="flex flex-col sm:flex-row sm:items-end justify-between gap-space-sm pb-space-sm"><div class="flex flex-col gap-space-xs"><div class="flex items-center gap-space-xs font-label-code text-label-code text-secondary tracking-widest uppercase"></div><h2 class="font-headline-lg text-headline-lg text-on-surface font-bold">Featured Projects</h2></div></div><div class="grid grid-cols-1 lg:grid-cols-2 gap-space-lg"><article class="flex flex-col rounded-lg bg-surface-container-low/95 backdrop-blur-xl shadow-xl overflow-hidden hover:bg-surface-container transition-all group"><div class="px-space-md py-space-sm bg-surface-container flex items-center justify-between"><div class="flex items-center gap-space-xs"><span class="font-label-code text-label-code text-on-surface-variant">TECTHA_ORCHESTRATOR // BUILD_v2.4.1</span></div><span class="font-caption text-caption text-secondary font-bold">PRODUCTION GRADE</span></div><div class="p-space-lg flex flex-col gap-space-md flex-1"><div class="flex flex-col gap-space-xs"><h3 class="font-headline-md text-headline-md text-on-surface font-bold group-hover:text-secondary transition-colors">Tec Tha — Multi-Agent AI Automation Platform</h3><p class="font-body-md text-body-md text-on-surface-variant">Autonomous multi-agent orchestration framework designed for complex web execution, automated testing, and LLM reasoning pipelines.</p></div><div class="rounded bg-surface-container-lowest/80 p-space-md flex flex-col gap-space-sm"><div class="flex items-center justify-between text-outline font-label-code text-label-code"><span>HYBRID_ROUTER_ACTIVE</span><span class="text-secondary">&lt; 180ms RESPONSE</span></div><div class="w-full bg-surface-container rounded-full h-1.5 overflow-hidden"><div class="bg-gradient-to-r from-secondary to-primary h-full w-4/5 rounded-full"></div></div><div class="grid grid-cols-2 gap-space-xs pt-space-xs font-label-code text-label-code"><div class="text-on-surface-variant">Claude 3.5: <span class="text-secondary">Synthesizing</span></div><div class="text-on-surface-variant">Groq LPU: <span class="text-primary">Fast Dispatch</span></div></div></div><div class="flex flex-col gap-space-xs"><span class="font-label-code text-label-code text-outline uppercase tracking-wider">Key Architectural Specs:</span><ul class="flex flex-col gap-space-xs font-body-md text-body-md text-on-surface"><li class="flex items-start gap-space-xs"><span class="material-symbols-outlined text-secondary text-sm pt-0.5">check_circle</span><span>Autonomous execution with sub-second decision loops</span></li><li class="flex items-start gap-space-xs"><span class="material-symbols-outlined text-secondary text-sm pt-0.5">check_circle</span><span>Claude API & Groq hybrid model routing engine</span></li><li class="flex items-start gap-space-xs"><span class="material-symbols-outlined text-secondary text-sm pt-0.5">check_circle</span><span>Dynamic web interaction via Playwright browser matrix</span></li><li class="flex items-start gap-space-xs"><span class="material-symbols-outlined text-secondary text-sm pt-0.5">check_circle</span><span>Scalable relational persistence with Prisma ORM & Redis caching</span></li></ul></div><div class="flex flex-wrap gap-space-xs pt-space-xs"><span class="px-space-sm py-0.5 rounded bg-surface-container-high text-secondary font-label-code text-label-code">Claude API</span><span class="px-space-sm py-0.5 rounded bg-surface-container-high text-primary font-label-code text-label-code">Groq</span><span class="px-space-sm py-0.5 rounded bg-surface-container-high text-on-surface font-label-code text-label-code">Playwright</span><span class="px-space-sm py-0.5 rounded bg-surface-container-high text-on-surface font-label-code text-label-code">Prisma</span><span class="px-space-sm py-0.5 rounded bg-surface-container-high text-on-surface font-label-code text-label-code">TypeScript</span><span class="px-space-sm py-0.5 rounded bg-surface-container-high text-on-surface font-label-code text-label-code">Redis</span><span class="px-space-sm py-0.5 rounded bg-surface-container-high text-on-surface font-label-code text-label-code">Docker</span></div></div></article><article class="flex flex-col rounded-lg bg-surface-container-low/95 backdrop-blur-xl shadow-xl overflow-hidden hover:bg-surface-container transition-all group"><div class="px-space-md py-space-sm bg-surface-container flex items-center justify-between"><div class="flex items-center gap-space-xs"><span class="w-2 h-2 rounded-full bg-primary"></span><span class="font-label-code text-label-code text-on-surface-variant">VOXA_FINTECH // ARCH_v3.1.0</span></div><span class="font-caption text-caption text-primary font-bold">FULL-STACK FINTECH</span></div><div class="p-space-lg flex flex-col gap-space-md flex-1"><div class="flex flex-col gap-space-xs"><h3 class="font-headline-md text-headline-md text-on-surface font-bold group-hover:text-primary transition-colors">VOXA — Personal Finance Expense Tracker</h3><p class="font-body-md text-body-md text-on-surface-variant">Intelligent financial analytics and automated expense tracking platform with real-time receipt scanning and automated categorization.</p></div><div class="rounded bg-surface-container-lowest/80 p-space-md flex flex-col gap-space-sm"><div class="flex items-center justify-between text-outline font-label-code text-label-code"><span>OCR_PARSER_EXTRACTOR</span><span class="text-primary">99.4% ACCURACY</span></div><div class="flex items-center gap-space-md"><div class="flex-1 bg-surface-container rounded p-space-xs text-center font-label-code text-label-code"><span class="text-outline">SCAN:</span><span class="text-secondary">$1,420.50</span></div><div class="flex-1 bg-surface-container rounded p-space-xs text-center font-label-code text-label-code"><span class="text-outline">GATEWAY:</span><span class="text-primary">STRIPE + RAZORPAY</span></div></div></div><div class="flex flex-col gap-space-xs"><span class="font-label-code text-label-code text-outline uppercase tracking-wider">Key Architectural Specs:</span><ul class="flex flex-col gap-space-xs font-body-md text-body-md text-on-surface"><li class="flex items-start gap-space-xs"><span class="material-symbols-outlined text-primary text-sm pt-0.5">check_circle</span><span>Dual payment gateway integration (Stripe & Razorpay)</span></li><li class="flex items-start gap-space-xs"><span class="material-symbols-outlined text-primary text-sm pt-0.5">check_circle</span><span>High-accuracy receipt OCR extraction pipeline with Tesseract</span></li><li class="flex items-start gap-space-xs"><span class="material-symbols-outlined text-primary text-sm pt-0.5">check_circle</span><span>Automated spending forecasting via linear time-series analysis</span></li><li class="flex items-start gap-space-xs"><span class="material-symbols-outlined text-primary text-sm pt-0.5">check_circle</span><span>Serverless NestJS microservice architecture on PostgreSQL</span></li></ul></div><div class="flex flex-wrap gap-space-xs pt-space-xs"><span class="px-space-sm py-0.5 rounded bg-surface-container-high text-secondary font-label-code text-label-code">Next.js 14</span><span class="px-space-sm py-0.5 rounded bg-surface-container-high text-primary font-label-code text-label-code">NestJS</span><span class="px-space-sm py-0.5 rounded bg-surface-container-high text-on-surface font-label-code text-label-code">Stripe</span><span class="px-space-sm py-0.5 rounded bg-surface-container-high text-on-surface font-label-code text-label-code">Razorpay</span><span class="px-space-sm py-0.5 rounded bg-surface-container-high text-on-surface font-label-code text-label-code">Tesseract OCR</span><span class="px-space-sm py-0.5 rounded bg-surface-container-high text-on-surface font-label-code text-label-code">Tailwind CSS</span><span class="px-space-sm py-0.5 rounded bg-surface-container-high text-on-surface font-label-code text-label-code">PostgreSQL</span></div></div></article><article class="flex flex-col rounded-lg bg-surface-container-low/95 backdrop-blur-xl shadow-xl overflow-hidden hover:bg-surface-container transition-all group"><div class="px-space-md py-space-sm bg-surface-container flex items-center justify-between"><div class="flex items-center gap-space-xs"><span class="font-label-code text-label-code text-on-surface-variant">GIGAMED_STOREFRONT // ECOMMERCE_v2.5.0</span></div><span class="font-caption text-caption text-secondary font-bold">HEALTHCARE ENTERPRISE</span></div><div class="p-space-lg flex flex-col gap-space-md flex-1"><div class="flex flex-col gap-space-xs"><h3 class="font-headline-md text-headline-md text-on-surface font-bold group-hover:text-secondary transition-colors">GigaMed — Healthcare Ecommerce Storefront</h3><p class="font-body-md text-body-md text-on-surface-variant">Multi-tenancy healthcare product marketplace with GraphQL APIs, real-time inventory sync, and internationalized customer experiences across 12+ regions.</p></div><div class="rounded bg-surface-container-lowest/80 p-space-md flex flex-col gap-space-sm"><div class="flex items-center justify-between text-outline font-label-code text-label-code"><span>APOLLO_GRAPHQL_ACTIVE</span><span class="text-secondary">99.2% UPTIME</span></div><div class="grid grid-cols-2 gap-space-xs pt-space-xs font-label-code text-label-code"><div class="text-on-surface-variant">Products: <span class="text-secondary">50k+</span></div><div class="text-on-surface-variant">Users: <span class="text-primary">120k+</span></div></div></div><div class="flex flex-col gap-space-xs