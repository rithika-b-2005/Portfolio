<!DOCTYPE html><html class="dark" lang="en"><head><meta charset="utf-8"><meta content="width=device-width, initial-scale=1.0" name="viewport"><meta content="web_standard" name="shell-type"><link href="https://fonts.googleapis.com" rel="preconnect"><link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect"><link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&amp;family=Space+Mono:ital,wght@0,400;0,700;1,400&amp;display=swap" rel="stylesheet"><link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0" rel="stylesheet"><link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"><style>@layer base{html{scroll-behavior:smooth;}html,body{margin:0;padding:0;}body{overscroll-behavior:none;}main>:first-child{margin-top:0!important;}main>:last-child{margin-bottom:0!important;}}::-webkit-scrollbar{display:none;}</style><script src="https://cdn.tailwindcss.com"></script><script src="https://cdn.jsdelivr.net/npm/@emailjs/browser@3/dist/index.min.js"></script><script id="tailwind-config">tailwind.config = { darkMode: "class", theme: { extend: { "colors": { "surface-dim": "#0b1326", "on-primary": "#3c0091", "surface-variant": "#2d3449", "primary-container": "#a078ff", "tertiary-fixed-dim": "#adc6ff", "primary-fixed-dim": "#d0bcff", "on-error": "#690005", "on-tertiary": "#002e6a", "on-secondary-container": "#00424e", "surface-container-high": "#222a3d", "inverse-on-surface": "#283044", "surface-container-low": "#131b2e", "on-secondary": "#003640", "tertiary": "#adc6ff", "secondary-fixed-dim": "#4cd7f6", "on-error-container": "#ffdad6", "error": "#ffb4ab", "outline": "#958ea0", "primary": "#d0bcff", "surface-tint": "#d0bcff", "inverse-primary": "#6d3bd7", "on-surface-variant": "#cbc3d7", "secondary-container": "#03b5d3", "background": "#0b1326", "tertiary-fixed": "#d8e2ff", "on-surface": "#dae2fd", "surface-bright