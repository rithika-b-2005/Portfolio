transition-all" type="submit"><span class="material-symbols-outlined text-base">send</span><span>TRANSMIT</span></button></div></form></div></div></div></section></div></main><footer></div><nav class="flex items-center gap-space-lg"></nav></footer><script>emailjs.init('U_gJnn-m6HrRucq6h');function copyEmail(){const email='rithikababu008@gmail.com';navigator.clipboard.writeText(email).then(()=>{const statusEl=document.getElementById('copy-status');if(statusEl){statusEl.innerText='COPIED!';setTimeout(()=>{statusEl.innerText='COPY';},2000);}});}function sendEmail(e){e.preventDefault();const form=e.target;const params={name:document.getElementById('contact-name').value,email:document.getElementById('contact-email').value,message:document.getElementById('contact-message').value};emailjs.send('service_xlr9y7c','template_elumf9j',params).then(()=>{const feedback=document.getElementById('form-feedback');feedback.classList.remove('hidden');form.reset();setTimeout(()=>{feedback.classList.add('hidden');},4000);}).catch(err=>{alert('Failed to send: '+err.text);})}function updateActiveNav(){const sections=[{id:'',label:'About'},{id:'featured-projects',label:'Projects'},{id:'skills',label:'Skills'},{id:'timeline',label:'Timeline'},{id:'contact',label:'Contact'}];let current='about';const navLinks=document.querySelectorAll('nav a[href^="#"]');sections.forEach(section=>{const el=section.id?document.getElementById(section.id):null;if(el){const rect=el.getBoundingClientRect();if(rect.top<=150){current=section.id||'about';}}});navLinks.forEach(link=>{const href=link.getAttribute('href');const isActive=(href==='#'&&current==='about')||(href.slice(1)===current);if(isActive){link.classList.add('bg-surface-container-high','text-secondary');link.classList.remove('text-on-surface-variant');link.setAttribute('aria-current','page');}else{link.classList.remove('bg-surface-container-high','text-secondary');link.classList.add('text-on-surface-variant');link.removeAttribute('aria-current');}});}document.querySelectorAll('nav a[href^="#"]').forEach(link=>{link.addEventListener('click',updateActiveNav);});window.addEventListener('scroll',updateActiveNav);updateActiveNav();}function updateActiveNav(){const sections=[{id:'',label:'About'},{id:'featured-projects',label:'Projects'},{id:'skills',label:'Skills'},{id:'timeline',label:'Timeline'},{id:'contact',label:'Contact'}];let current='about';const navLinks=document.querySelectorAll('nav a[href^="#"]');sections.forEach(section=>{const el=section.id?document.getElementById(section.id):null;if(el){const rect=el.getBoundingClientRect();if(rect.top<=150){current=section.id||'about';}}});navLinks.forEach(link=>{const href=link.getAttribute('href');const isActive=(href==='#'&&current==='about')||(href.slice(1)===current);if(isActive){link.classList.add('bg-surface-container-high','text-secondary');link.classList.remove('text-on-surface-variant');link.setAttribute('aria-current','page');}else{link.classList.remove('bg-surface-container-high','text-secondary');link.classList.add('text-on-surface-variant');link.removeAttribute('aria-current');}});}document.querySelectorAll('nav a[href^="#"]').forEach(link=>{link.addEventListener('click',updateActiveNav);});window.addEventListener('scroll',updateActiveNav);updateActiveNav();</script></body></html>